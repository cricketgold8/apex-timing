# ---------------------------------------------------------------------------
# APEX TIMING — environment configuration
# Copy to .env.local and fill in. Never commit real credentials.
# All variables are read on the server only (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# OpenF1 real-time access (paid OpenF1 account — see https://openf1.org/auth.html).
# Without these, LIVE mode reports "credentials not configured" and the app
# offers historical (free, unauthenticated) and demo data instead.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Optional overrides (defaults shown).
OPENF1_BASE_URL=https://api.openf1.org
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Minimum interval between upstream OpenF1 requests made by this server, in ms.
# Keeps the free tier within its rate limits. Lower only if your plan allows it.
OPENF1_MIN_REQUEST_SPACING_MS=350
